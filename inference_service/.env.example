# 推理服务环境变量样例。复制为 .env 后按实际环境填写，.env 不入库。

# jina-embeddings-v4 模型目录（本地路径，离线加载）
MODEL_PATH=

# 向量库（sqlite-vec）数据库文件路径
VECTOR_DB_PATH=

# sqlite-vec 可加载扩展路径（平台相关，Linux aarch64 与 Windows/x64 不通用，
# 从 https://github.com/asg017/sqlite-vec/releases 取对应平台的
# sqlite-vec-<版本>-loadable-<平台> 文件即可）
VECTOR_DB_DRIVER=

# 视觉分析（GLM 多模态）。base_url 默认智谱开放平台，换兼容端点时修改
GLM_API_KEY=
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=
CHAT_MODEL=

# 服务监听端口，默认 8100
INFERENCE_PORT=8100
